 "measures": [
  {
   "name": "Xp",
   "from": "dt_2",
   "to": "gt_2"
  },
  {
   "name": "Xd",
   "from": "gt_1",
   "to": "dt_1",
   "at": 8
  },
  {
   "name": "Wp",
   "from": "pw_3",
   "to": "pw_1"
  },
  {
   "name": "Sk",
   "from": "ka_2",
   "to": "kb_0"
  },
  {
   "name": "Sk2",
   "from": "kb_1",
   "to": "kc_3"
  },
  {
   "name": "Ek",
   "from": "dc_3",
   "to": "ka_3"
  }
 ],
 "constraints": [
  {
   "kind": "match",
   "expr": "DT.layer == diff"
  },
  {
   "kind": "match",
   "expr": "GT.layer == poly"
  },
  {
   "kind": "match",
   "expr": "PW.layer == poly"
  },
  {
   "kind": "match",
   "expr": "DC.layer == diff"
  },
  {
   "kind": "match",
   "expr": "KA.layer == cont"
  },
  {
   "kind": "match",
   "expr": "KB.layer == cont"
  },
  {
   "kind": "match",
   "expr": "KC.layer == cont"
  },
  {
   "kind": "match",
   "expr": "ka_0.length == ka_1.length"
  },
  {
   "kind": "match",
   "expr": "kb_0.length == kb_1.length"
  },
  {
   "kind": "match",
   "expr": "kc_0.length == kc_1.length"
  }
 ],
 "rules": [
  {
   "name": "PO.1",
   "desc": "Poly width",
   "constraints": [
    {
     "kind": "check",
     "expr": "Wp >= 0.15"
    }
   ]
  },
  {
   "name": "PO.2",
   "desc": "Poly extension beyond diffusion (end cap)",
   "constraints": [
    {
     "kind": "check",
     "expr": "Xp >= 0.2"
    }
   ]
  },
  {
   "name": "PO.3",
   "desc": "Diffusion extension beyond the gate",
   "constraints": [
    {
     "kind": "check",
     "expr": "Xd >= 0.25"
    }
   ]
  },
  {
   "name": "CO.1",
   "desc": "Contact size",
   "constraints": [
    {
     "kind": "check",
     "expr": "ka_0.length == 0.2"
    }
   ],
   "extended": true
  },
  {
   "name": "CO.2",
   "desc": "Contact space",
   "constraints": [
    {
     "kind": "check",
     "expr": "Sk >= 0.25"
    }
   ]
  },
  {
   "name": "CO.3",
   "desc": "Contact space in an array of 4 x 4 or more (one direction is enough)",
   "constraints": [
    {
     "kind": "match",
     "expr": "KA.rows >= 4 and KA.columns >= 4"
    },
    {
     "kind": "match",
     "expr": "KB.rows >= 4 and KB.columns >= 4"
    },
    {
     "kind": "match",
     "expr": "KC.rows >= 4 and KC.columns >= 4"
    },
    {
     "kind": "match",
     "expr": "ka_0.length == 0.2"
    },
    {
     "kind": "match",
     "expr": "kb_0.length == 0.2"
    },
    {
     "kind": "match",
     "expr": "kc_0.length == 0.2"
    },
    {
     "kind": "check",
     "expr": "Sk >= 0.3 or Sk2 >= 0.3"
    }
   ]
  },
  {
   "name": "CO.4",
   "desc": "Diffusion enclosure of contact",
   "constraints": [
    {
     "kind": "check",
     "expr": "Ek >= 0.1"
    }
   ]
  }
 ]
}
