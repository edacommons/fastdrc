   "from": "pd_1",
   "to": "nt_3"
  }
 ],
 "constraints": [
  {
   "kind": "match",
   "expr": "NA.layer == nwell"
  },
  {
   "kind": "match",
   "expr": "NB.layer == nwell"
  },
  {
   "kind": "match",
   "expr": "NW.layer == nwell"
  },
  {
   "kind": "match",
   "expr": "PD.layer == pdiff"
  },
  {
   "kind": "match",
   "expr": "NT.layer == ndiff"
  }
 ],
 "rules": [
  {
   "name": "NW.1",
   "desc": "N-well width",
   "constraints": [
    {
     "kind": "check",
     "expr": "Wn >= 0.8"
    }
   ]
  },
  {
   "name": "NW.2",
   "desc": "N-well space",
   "constraints": [
    {
     "kind": "check",
     "expr": "Sn >= 1.0"
    }
   ]
  },
  {
   "name": "NW.3",
   "desc": "N-well space, wells on different nets",
   "constraints": [
    {
     "kind": "match",
     "expr": "NA.net != NB.net"
    },
    {
     "kind": "check",
     "expr": "Sn >= 2.0"
    }
   ]
  },
  {
   "name": "NW.4",
   "desc": "N-well enclosure of P+ diffusion",
   "constraints": [
    {
     "kind": "check",
     "expr": "Ep >= ?"
    }
   ],
   "values": {
    "thin": 0.3,
    "thick": 0.6
   }
  },
  {
   "name": "LU.1",
   "desc": "P+ diffusion to the nearest well tap",
   "constraints": [
    {
     "kind": "check",
     "expr": "Sl <= 20"
    }
   ],
   "with": [
    "NW"
   ]
  }
 ]
}
