 "rules": [
  {
   "name": "V1.1",
   "desc": "Metal-1 enclosure of via-1 on one of two adjacent sides",
   "constraints": [
    {
     "kind": "check",
     "expr": "Ea >= 0.1 or Eb >= 0.1"
    }
   ]
  },
  {
   "name": "V1.2",
   "desc": "Vias on metal-1 wider than 2",
   "constraints": [
    {
     "kind": "match",
     "expr": "Ww >= 2"
    },
    {
     "kind": "check",
     "expr": "Count(VW) >= 2"
    }
   ]
  },
  {
   "name": "AN.1",
   "desc": "Metal-1 area per connected gate area",
   "constraints": [
    {
     "kind": "check",
     "expr": "MP.area <= 400 * GA.area"
    }
   ]
  },
  {
   "name": "DN.1",
   "desc": "Metal-1 density over the chip",
   "constraints": [
    {
     "kind": "check",
     "expr": "MD.density >= 0.2 and MD.density <= 0.8"
    }
   ],
   "with": [
    "CHIP"
   ]
  },
  {
   "name": "DN.2",
   "desc": "Metal-1 density in any 100 x 100 window",
   "constraints": [
    {
     "kind": "check",
     "expr": "MN.density <= 0.9"
    }
   ],
   "with": [
    "WIN"
   ]
  }
 ]
}
